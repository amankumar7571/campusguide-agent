# Copy to .env and fill in. Never commit a real .env.
# GEMINI_API_KEY is OPTIONAL — without it the app uses the local TF-IDF
# embedding fallback (documented in backend/embeddings.py).
GEMINI_API_KEY=
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRE_MINUTES=480
# Local default is SQLite. For Postgres+pgvector deployment, set e.g.:
# DATABASE_URL=postgresql+psycopg2://campusguide:campusguide@localhost:5432/campusguide
DATABASE_URL=sqlite:///./campusguide.db
MAX_STEPS_PER_REQUEST=8
MAX_TOKENS_PER_REQUEST=4000
TOP_K=5
# CORS origins, comma-separated. Default is the local dev frontend only.
# On deploy set this to your frontend domain, e.g.:
# CORS_ORIGINS=https://campusguide.vercel.app
